{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "เครื่องมือ PDF ที่ทำงานในเบราว์เซอร์ (รวม แยก หมุน จัดหน้า แปลงรูป ลายน้ำ เลขหน้า) — ไฟล์ไม่ออกจากเครื่องผู้ใช้",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs.mjs",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "fflate": "^0.8.3",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
